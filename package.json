{
  "name": "affordable-golf-cart-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Static marketing site for Affordable Golf Cart Service. Vite + React, prerendered, deployed to GitHub Pages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "clean": "tsx script/clean.ts",
    "fetch-data": "tsx script/fetch-data.ts",
    "generate-seo": "tsx script/generate-seo.ts",
    "optimize-assets": "tsx script/optimize-assets.ts",
    "vite:build": "vite build && vite build --config vite.ssr.config.ts",
    "prerender": "tsx script/prerender.ts",
    "verify": "tsx script/verify-dist.ts",
    "build": "npm run clean && npm run fetch-data && npm run generate-seo && npm run optimize-assets && npm run vite:build && npm run prerender && npm run verify",
    "build:site": "npm run clean && npm run generate-seo && npm run optimize-assets && npm run vite:build && npm run prerender && npm run verify",
    "preview": "tsx script/serve-dist.ts",
    "check": "tsc"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.4",
    "svgo": "^3.3.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.0",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0"
  }
}
